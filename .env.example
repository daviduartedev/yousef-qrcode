# Copy to .env.local and replace placeholders; never commit real values.
# Server-side Postgres connection. Neon provides a pooled URL for the app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
APP_URL=http://localhost:3000
# Only set this behind a trusted reverse proxy which overwrites forwarded headers.
TRUST_PROXY_HEADERS=false
# Optional: a direct/session connection used only for migrations.
# DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# Neon CLI supplies DATABASE_URL_UNPOOLED as the fallback for migrations.
# Only in a separate private .env.operations.* file for db:inspect/prepare/backup/restore.
# Valid aliases: local, staging, production, restore. Keep .env.local for local development.
# OPERATIONS_ENVIRONMENT=staging
