{
  "name": "yousef-qrcode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:security": "node --test tests/security.test.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:local": "node scripts/setup-local.mjs",
    "db:up": "docker compose --env-file .env.local up -d",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:inspect": "node scripts/database-ops.mjs inspect",
    "db:prepare": "node scripts/database-ops.mjs prepare",
    "db:backup": "node scripts/database-ops.mjs backup",
    "db:restore": "node scripts/database-ops.mjs restore",
    "test:ops": "node --test tests/database-ops.test.mjs",
    "test:api": "node scripts/test-api.mjs",
    "test": "npm run test:security && npm run test:ops && npm run test:api"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.15",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "better-auth": "1.7.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "i18next": "^25.6.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.462.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "qr-code-styling": "^1.9.2",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^16.3.5",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.32.0",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
